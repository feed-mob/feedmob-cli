#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'optparse'
require 'json'
require 'rbconfig'
require 'tmpdir'
require_relative '../lib/feedmob/cli/version'
require_relative 'release_support'

options = {}
OptionParser.new do |parser|
  parser.on('--config PATH') { |path| options[:config] = File.expand_path(path) }
  parser.on('--target TARGET', FeedMobRelease::TARGET_IDS) { |target| options[:target] = target }
end.parse!

config_path = options.fetch(:config, File.expand_path('../packaging/release.yml', __dir__))
target_id = options.fetch(:target)
config = FeedMobRelease.load_config(config_path)
target = FeedMobRelease.target!(config, target_id)
FeedMobRelease.assert_native_target!(target_id, target)
artifact = File.expand_path(ARGV.fetch(0))
unless File.file?(artifact) && File.executable?(artifact) && !File.symlink?(artifact)
  abort "#{artifact} is not a regular executable file"
end
FeedMobRelease.validate_binary_format!(artifact, target)
FeedMobRelease.verify_glibc_requirement!(artifact, target)
FeedMobRelease.verify_dynamic_dependencies!(artifact) if target.fetch('os') == 'linux'

puts "Top-level target: #{target_id}"

Dir.mktmpdir('feedmob-cli-release-extract') do |extracted_root|
  extract_stdout, extract_stderr, extract_status = Open3.capture3(
    artifact, '--tebako-extract', extracted_root
  )
  abort "Could not extract #{artifact}: #{extract_stderr}#{extract_stdout}" unless extract_status.success?

  tree_stdout, tree_stderr, tree_status = Open3.capture3(
    RbConfig.ruby,
    File.join(__dir__, 'verify-release-tree'),
    '--config', config_path,
    '--target', target_id,
    extracted_root
  )
  abort tree_stderr unless tree_status.success?

  print tree_stdout
end

Dir.mktmpdir('feedmob-cli-release-home') do |temporary_home|
  version_stdout, version_stderr, version_status = Open3.capture3(
    { 'HOME' => temporary_home, 'PATH' => '/usr/bin:/bin' },
    artifact, '--json', 'version',
    unsetenv_others: true
  )
  abort "Version smoke failed: #{version_stderr}#{version_stdout}" unless version_status.success?

  version_payload = JSON.parse(version_stdout)
  version = version_payload.dig('data', 'version')
  unless version_payload['ok'] == true && version == FeedMob::CLI::VERSION
    abort "Version smoke returned an unexpected payload: #{version_stdout}"
  end

  puts "Version smoke: #{version}"
end
