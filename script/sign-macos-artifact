#!/usr/bin/env ruby
# frozen_string_literal: true

# Signs and notarizes a pressed macOS release artifact. Publish-only: every
# credential comes from the protected `release` environment, the temporary
# keychain is always destroyed, and no secret value is ever printed.

require 'fileutils'
require 'open3'
require 'optparse'
require 'rbconfig'
require 'shellwords'
require 'tmpdir'
require_relative 'release_support'

options = { config: File.expand_path('../packaging/release.yml', __dir__) }
OptionParser.new do |parser|
  parser.on('--config PATH') { |path| options[:config] = File.expand_path(path) }
  parser.on('--target TARGET', FeedMobRelease::TARGET_IDS) { |target| options[:target] = target }
  parser.on('--tebako PATH') { |path| options[:tebako] = File.expand_path(path) }
  parser.on('--artifact PATH') { |path| options[:artifact] = File.expand_path(path) }
end.parse!

target_id = options.fetch(:target)
tebako = options.fetch(:tebako)
artifact = options.fetch(:artifact)
config_path = options.fetch(:config)
target = FeedMobRelease.target!(FeedMobRelease.load_config(config_path), target_id)
abort "sign-macos-artifact only supports macOS targets, got #{target_id}" unless target.fetch('os') == 'macos'
FeedMobRelease.assert_native_target!(target_id, target)
abort "#{artifact} is not a regular executable file" unless File.file?(artifact) && File.executable?(artifact)

REQUIRED_SECRETS = %w[
  DEVELOPER_ID_APPLICATION_P12
  DEVELOPER_ID_APPLICATION_P12_PASSWORD
  NOTARYTOOL_API_KEY_P8
  NOTARYTOOL_KEY_ID
  NOTARYTOOL_ISSUER
].freeze
missing = REQUIRED_SECRETS.select { |name| ENV[name].to_s.empty? }
abort "Missing signing secrets: #{missing.join(', ')}" unless missing.empty?

def run!(*command, sensitive: [])
  stdout, stderr, status = Open3.capture3(*command)
  return stdout if status.success?

  detail = "#{stdout}#{stderr}"
  sensitive.each { |secret| detail = detail.gsub(secret, '[redacted]') }
  abort "Command failed: #{command.first(2).join(' ')}\n#{detail}"
end

unsigned_sha256 = FeedMobRelease.sha256(artifact)
keychain_password = nil
submission_id = nil

Dir.mktmpdir('feedmob-cli-signing') do |directory|
  keychain = File.join(directory, 'signing.keychain-db')
  keychain_password = "fm-#{unsigned_sha256}"
  p12 = File.join(directory, 'developer-id.p12')
  api_key = File.join(directory, 'AuthKey.p8')

  begin
    File.binwrite(p12, ENV.fetch('DEVELOPER_ID_APPLICATION_P12').unpack1('m'))
    File.binwrite(api_key, ENV.fetch('NOTARYTOOL_API_KEY_P8'))
    FileUtils.chmod(0o600, [p12, api_key])

    run!('security', 'create-keychain', '-p', keychain_password, keychain, sensitive: [keychain_password])
    run!('security', 'set-keychain-settings', keychain)
    run!(
      'security', 'import', p12, '-k', keychain,
      '-P', ENV.fetch('DEVELOPER_ID_APPLICATION_P12_PASSWORD'),
      '-T', '/usr/bin/codesign',
      sensitive: [ENV.fetch('DEVELOPER_ID_APPLICATION_P12_PASSWORD')]
    )
    run!('security', 'set-key-partition-list', '-S', 'apple-tool:,apple:', '-k', keychain_password, keychain,
         sensitive: [keychain_password])

    identities = run!('security', 'find-identity', '-v', '-p', 'codesigning', keychain)
    match = identities.match(/"([0-9A-F]{40})"\s+"(Developer ID Application: [^"]+)"/)
    abort "No Developer ID Application identity in #{p12}" unless match

    identity_hash, identity_name = match.captures
    run!(
      'codesign', '--sign', identity_hash, '--keychain', keychain,
      '--options', 'runtime', '--timestamp', '--force', artifact
    )
    run!('codesign', '--verify', '--deep', '--strict', '--verbose=2', artifact)
    puts "Signed with: #{identity_name}"

    zip = File.join(directory, 'notarize.zip')
    run!('ditto', '-c', '-k', '--keepParent', artifact, zip)
    submission = run!(
      'xcrun', 'notarytool', 'submit', zip,
      '--key', api_key,
      '--key-id', ENV.fetch('NOTARYTOOL_KEY_ID'),
      '--issuer', ENV.fetch('NOTARYTOOL_ISSUER'),
      '--wait', '--timeout', '30m',
      sensitive: [ENV.fetch('NOTARYTOOL_ISSUER'), ENV.fetch('NOTARYTOOL_KEY_ID')]
    )
    abort "Notarization failed:\n#{submission}" unless submission.match?(/^  status: Accepted$/)

    submission_id = submission[/^  id: ([0-9a-f-]{36})$/i, 1]
    puts "Notarization accepted: #{submission_id}"

    _stdout, _stderr, staple_status = Open3.capture3('xcrun', 'stapler', 'staple', artifact)
    if staple_status.success?
      puts 'Stapled notarization ticket'
    else
      puts 'Stapling unsupported for this container; online notarization check applies'
    end
  ensure
    Open3.capture3('security', 'delete-keychain', keychain) if File.exist?(keychain)
  end
end

validated = system(
  RbConfig.ruby,
  File.join(__dir__, 'verify-release-artifact'),
  '--config', config_path,
  '--target', target_id,
  '--tebako', tebako,
  artifact
)
abort 'Signed artifact validation failed' unless validated

signed_sha256 = FeedMobRelease.sha256(artifact)
puts 'Signing provenance:'
puts "  unsigned sha256: #{unsigned_sha256}"
puts "  signed sha256:   #{signed_sha256}"
puts "  notarytool id:   #{submission_id}"
