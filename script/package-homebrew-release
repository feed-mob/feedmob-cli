#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'open3'
require 'optparse'
require 'rbconfig'
require 'tmpdir'

options = {}
OptionParser.new do |parser|
  parser.on('--arm64 PATH') { |path| options[:arm64] = File.expand_path(path) }
  parser.on('--x86-64 PATH') { |path| options[:x86_64] = File.expand_path(path) }
  parser.on('--output PATH') { |path| options[:output] = File.expand_path(path) }
end.parse!

artifacts = {
  'arm64' => options.fetch(:arm64),
  'x86_64' => options.fetch(:x86_64)
}
output = options.fetch(:output)

artifacts.each do |architecture, artifact|
  validated = system(
    RbConfig.ruby,
    File.join(__dir__, 'verify-release-artifact'),
    '--architecture', architecture,
    artifact
  )
  abort "#{architecture} standalone artifact validation failed" unless validated
end

if File.exist?(output) && (!File.directory?(output) || !Dir.empty?(output))
  abort "Output directory is not empty: #{output}"
end

archive_names = {
  'arm64' => 'fm-darwin-arm64.tar.gz',
  'x86_64' => 'fm-darwin-x86_64.tar.gz'
}

Dir.mktmpdir('feedmob-cli-homebrew-release') do |temporary_directory|
  checksums = archive_names.map do |architecture, archive_name|
    staging_directory = File.join(temporary_directory, "staging-#{architecture}")
    staged_binary = File.join(staging_directory, 'fm')
    archive = File.join(temporary_directory, archive_name)
    FileUtils.mkdir_p(staging_directory)
    FileUtils.cp(artifacts.fetch(architecture), staged_binary)
    FileUtils.chmod(0o755, staged_binary)

    archived = system(
      { 'COPYFILE_DISABLE' => '1' },
      'tar', '-czf', archive,
      '-C', staging_directory,
      'fm'
    )
    abort "Could not create #{archive_name}" unless archived

    listing_stdout, listing_stderr, listing_status = Open3.capture3('tar', '-tzf', archive)
    abort "Could not inspect #{archive_name}: #{listing_stderr}" unless listing_status.success?
    unless listing_stdout.lines(chomp: true) == ['fm']
      abort "Unexpected files in #{archive_name}: #{listing_stdout.lines(chomp: true).join(', ')}"
    end

    "#{Digest::SHA256.file(archive).hexdigest}  #{archive_name}"
  end

  checksum_file = File.join(temporary_directory, 'SHA256SUMS')
  File.write(checksum_file, "#{checksums.join("\n")}\n")

  FileUtils.mkdir_p(output)
  archive_names.each_value do |archive_name|
    FileUtils.mv(File.join(temporary_directory, archive_name), File.join(output, archive_name))
  end
  FileUtils.mv(checksum_file, File.join(output, 'SHA256SUMS'))
end

puts "Created Homebrew release assets: #{output}"
