#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'open3'
require 'optparse'
require 'rbconfig'
require 'tmpdir'
require_relative 'release_support'

options = { config: File.expand_path('../packaging/release.yml', __dir__) }
OptionParser.new do |parser|
  parser.on('--config PATH') { |path| options[:config] = File.expand_path(path) }
  parser.on('--target TARGET', FeedMobRelease::TARGET_IDS) { |target| options[:target] = target }
  parser.on('--artifact PATH') { |path| options[:artifact] = File.expand_path(path) }
  parser.on('--output PATH') { |path| options[:output] = File.expand_path(path) }
end.parse!

target_id = options.fetch(:target)
artifact = options.fetch(:artifact)
output = options.fetch(:output)
config_path = options.fetch(:config)
config = FeedMobRelease.load_config(config_path)
target = FeedMobRelease.target!(config, target_id)
FeedMobRelease.assert_native_target!(target_id, target)

if File.exist?(output) && (!File.directory?(output) || !Dir.empty?(output))
  abort "Output directory is not empty: #{output}"
end

validated = system(
  RbConfig.ruby,
  File.join(__dir__, 'verify-release-artifact'),
  '--config', config_path,
  '--target', target_id,
  artifact
)
abort "#{target_id} standalone artifact validation failed" unless validated

archive_name = target.fetch('archive')
Dir.mktmpdir('feedmob-cli-homebrew-artifact') do |temporary_directory|
  staging_directory = File.join(temporary_directory, 'staging')
  staged_binary = File.join(staging_directory, 'fm')
  archive = File.join(temporary_directory, archive_name)
  FileUtils.mkdir_p(staging_directory)
  FileUtils.cp(artifact, staged_binary)
  FileUtils.chmod(0o755, staged_binary)

  archived = system(
    { 'COPYFILE_DISABLE' => '1' },
    'tar', '-czf', archive,
    '-C', staging_directory,
    'fm'
  )
  abort "Could not create #{archive_name}" unless archived

  listing_stdout, listing_stderr, listing_status = Open3.capture3('tar', '-tzf', archive)
  abort "Could not inspect #{archive_name}: #{listing_stderr}" unless listing_status.success?
  unless listing_stdout.lines(chomp: true) == ['fm']
    abort "Unexpected files in #{archive_name}: #{listing_stdout.lines(chomp: true).join(', ')}"
  end

  FileUtils.mkdir_p(output)
  destination = File.join(output, archive_name)
  FileUtils.mv(archive, destination)
  File.write(File.join(output, "#{archive_name}.sha256"), "#{FeedMobRelease.sha256(destination)}  #{archive_name}\n")
end

puts "Created Homebrew release asset for #{target_id}: #{File.join(output, archive_name)}"
