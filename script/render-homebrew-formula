#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'optparse'

TARGET_IDS = %w[macos-arm64 macos-x86_64 linux-arm64 linux-x86_64].freeze

options = {}
OptionParser.new do |parser|
  parser.on('--version VERSION') { |value| options[:version] = value }
  parser.on('--assets-json PATH') { |path| options[:assets_json] = File.expand_path(path) }
  parser.on('--output PATH') { |path| options[:output] = File.expand_path(path) }
end.parse!

version = options.fetch(:version)
manifest = JSON.parse(File.read(options.fetch(:assets_json)))
assets = manifest.fetch('assets')
output = options.fetch(:output)

abort "Invalid version: #{version}" unless version.match?(/\A\d+\.\d+\.\d+(?:[-.][0-9A-Za-z.-]+)?\z/)
abort "Asset manifest version does not match #{version}" unless manifest.fetch('version') == version
abort "Asset manifest targets must be exactly: #{TARGET_IDS.join(', ')}" unless assets.keys.sort == TARGET_IDS.sort

TARGET_IDS.each do |id|
  asset = assets.fetch(id)
  abort "Invalid #{id} SHA-256" unless asset.fetch('sha256').match?(/\A[0-9a-f]{64}\z/)
  unless asset.fetch('name').match?(/\Afm-(?:darwin|linux)-(?:arm64|x86_64)\.tar\.gz\z/)
    abort "Invalid #{id} archive name"
  end
end

def asset_branch(version, asset)
  <<~RUBY.chomp
    url "https://github.com/feed-mob/feedmob-cli/releases/download/v#{version}/#{asset.fetch('name')}"
    sha256 "#{asset.fetch('sha256')}"
  RUBY
end

branches = TARGET_IDS.to_h { |id| [id, asset_branch(version, assets.fetch(id)).gsub("\n", "\n      ")] }

formula = <<~RUBY
  class Fm < Formula
    desc "Command-line interface for FeedMob services"
    homepage "https://github.com/feed-mob/feedmob-cli"
    license "MIT"
    version "#{version}"

    on_macos do
      on_arm do
        #{branches.fetch('macos-arm64')}
      end

      on_intel do
        #{branches.fetch('macos-x86_64')}
      end
    end

    on_linux do
      on_arm do
        #{branches.fetch('linux-arm64')}
      end

      on_intel do
        #{branches.fetch('linux-x86_64')}
      end
    end

    def install
      bin.install "fm"
    end

    test do
      assert_match version.to_s, shell_output("\#{bin}/fm --json version")
    end
  end
RUBY

FileUtils.mkdir_p(File.dirname(output))
temporary = "#{output}.tmp-#{Process.pid}"
File.write(temporary, formula)
FileUtils.mv(temporary, output)
puts "Rendered Homebrew Formula: #{output}"
