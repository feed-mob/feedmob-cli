#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require_relative 'release_support'

options = { config: File.expand_path('../packaging/release.yml', __dir__) }
OptionParser.new do |parser|
  parser.on('--config PATH') { |path| options[:config] = File.expand_path(path) }
  parser.on('--target TARGET', FeedMobRelease::TARGET_IDS) { |target| options[:target] = target }
end.parse!

tool = File.expand_path(ARGV.fetch(0))
target_id = options.fetch(:target)
config = FeedMobRelease.load_config(options.fetch(:config))
target = FeedMobRelease.target!(config, target_id)
FeedMobRelease.assert_native_target!(target_id, target)
expected_sha256 = target.fetch('tebako_sha256')
actual_sha256 = FeedMobRelease.sha256(tool)

unless actual_sha256 == expected_sha256
  abort "SHA-256 mismatch for #{tool}: expected #{expected_sha256}, got #{actual_sha256}"
end

FeedMobRelease.validate_binary_format!(tool, target)
FeedMobRelease.verify_glibc_requirement!(tool, target)

puts "Tebako tool verified for #{target_id}"
puts "Release: #{config.fetch('release_version')}"
puts "Format/runtime line: #{config.fetch('format_version')}"
puts "Ruby: #{config.fetch('ruby_version')}"
